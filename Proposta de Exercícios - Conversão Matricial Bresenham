        "import matplotlib.pyplot as plt\n",
        "\n",
        "def plot_8_symmetric_points(xc, yc, x, y, points_x, points_y):\n",
        "    # Simetria de 8 octantes deslocada pelo centro (xc, yc)\n",
        "    pts = [\n",
        "        (xc + x, yc + y), (xc - x, yc + y), (xc + x, yc - y), (xc - x, yc - y),\n",
        "        (xc + y, yc + x), (xc - y, yc + x), (xc + y, yc - x), (xc - y, yc - x)\n",
        "    ]\n",
        "    for px, py in pts:\n",
        "        points_x.append(px)\n",
        "        points_y.append(py)\n",
        "\n",
        "def bresenham_circle(xc, yc, r):\n",
        "    x = 0\n",
        "    y = r\n",
        "    d = 3 - 2 * r  # Variável de decisão inicial\n",
        "\n",
        "    points_x, points_y = [], []\n",
        "    plot_8_symmetric_points(xc, yc, x, y, points_x, points_y)\n",
        "\n",
        "    while y >= x:\n",
        "        x += 1\n",
        "        if d > 0:\n",
        "            y -= 1\n",
        "            d = d + 4 * (x - y) + 10\n",
        "        else:\n",
        "            d = d + 4 * x + 6\n",
        "\n",
        "        plot_8_symmetric_points(xc, yc, x, y, points_x, points_y)\n",
        "\n",
        "    return points_x, points_y\n",
        "\n",
        "# Exemplo de uso: Circunferência de raio 15 centrada em (20, 30)\n",
        "px, py = bresenham_circle(xc=20, yc=30, r=15)\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.scatter(px, py, color='blue', s=10)\n",
        "plt.gca().set_aspect('equal', adjustable='box')\n",
        "plt.title(\"Circunferência de Bresenham - Centro (20,30), Raio 15\")\n",
        "plt.grid(True)\n",
        "plt.show()"
