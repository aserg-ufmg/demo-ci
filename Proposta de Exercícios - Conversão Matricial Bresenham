        "import matplotlib.pyplot as plt\n",
        "\n",
        "def plot_4_symmetric_points(xc, yc, x, y, points_x, points_y):\n",
        "    # Simetria de 4 quadrantes deslocada pelo centro (xc, yc)\n",
        "    pts = [\n",
        "        (xc + x, yc + y), (xc - x, yc + y),\n",
        "        (xc + x, yc - y), (xc - x, yc - y)\n",
        "    ]\n",
        "    for px, py in pts:\n",
        "        points_x.append(px)\n",
        "        points_y.append(py)\n",
        "\n",
        "def bresenham_ellipse(xc, yc, rx, ry):\n",
        "    x = 0\n",
        "    y = ry\n",
        "\n",
        "    rx2 = rx * rx\n",
        "    ry2 = ry * ry\n",
        "\n",
        "    # Decisão inicial para a Região 1\n",
        "    d1 = ry2 - (rx2 * ry) + (0.25 * rx2)\n",
        "    dx = 2 * ry2 * x\n",
        "    dy = 2 * rx2 * y\n",
        "\n",
        "    points_x, points_y = [], []\n",
        "\n",
        "    # Região 1\n",
        "    while dx < dy:\n",
        "        plot_4_symmetric_points(xc, yc, x, y, points_x, points_y)\n",
        "        x += 1\n",
        "        dx += 2 * ry2\n",
        "        if d1 < 0:\n",
        "            d1 += dx + ry2\n",
        "        else:\n",
        "            y -= 1\n",
        "            dy -= 2 * rx2\n",
        "            d1 += dx - dy + ry2\n",
        "\n",
        "    # Decisão inicial para a Região 2\n",
        "    d2 = (ry2 * (x + 0.5)**2) + (rx2 * (y - 1)**2) - (rx2 * ry2)\n",
        "\n",
        "    # Região 2\n",
        "    while y >= 0:\n",
        "        plot_4_symmetric_points(xc, yc, x, y, points_x, points_y)\n",
        "        y -= 1\n",
        "        dy -= 2 * rx2\n",
        "        if d2 > 0:\n",
        "            d2 += rx2 - dy\n",
        "        else:\n",
        "            x += 1\n",
        "            dx += 2 * ry2\n",
        "            d2 += dx - dy + rx2\n",
        "\n",
        "    return points_x, points_y\n",
        "\n",
        "# Exemplo de uso: Elipse com rx=30, ry=15 centrada em (10, 10)\n",
        "px, py = bresenham_ellipse(xc=10, yc=10, rx=30, ry=15)\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.scatter(px, py, color='red', s=10)\n",
        "plt.gca().set_aspect('equal', adjustable='box')\n",
        "plt.title(\"Elipse de Bresenham - Centro (10,10), rx=30, ry=15\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
